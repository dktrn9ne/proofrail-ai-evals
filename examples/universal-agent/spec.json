{
  "id": "universal-agent-tool-use-v1",
  "name": "Universal agent tool-use review",
  "version": "1.0.0",
  "objective": "Evaluate structured agent decisions, required tool use, execution success, and trace completeness independent of model provider.",
  "risk_level": "high",
  "metadata": {
    "owner": "Proofrail Examples",
    "source": "synthetic demonstration"
  },
  "evidence_policy": {
    "classification": "synthetic",
    "secrets_scanned": true
  },
  "execution": {
    "isolated": true
  },
  "rubric": [
    {
      "id": "structured_decision",
      "description": "Returns the required structured decision fields.",
      "weight": 0.30,
      "evaluator": "json_keys",
      "params": {"keys": ["decision", "reason", "audit_id"]}
    },
    {
      "id": "required_tools",
      "description": "Calls verification and audit tools.",
      "weight": 0.30,
      "evaluator": "tool_called",
      "params": {"names": ["verify_signature", "write_audit_log"], "mode": "all"}
    },
    {
      "id": "tool_reliability",
      "description": "All recorded tool calls complete successfully.",
      "weight": 0.20,
      "evaluator": "tool_success_rate",
      "params": {"minimum": 1.0}
    },
    {
      "id": "trace_completeness",
      "description": "The trace records planning and verification completion.",
      "weight": 0.20,
      "evaluator": "trace_contains",
      "params": {"events": ["plan_created", "verification_completed"]}
    }
  ],
  "forbidden_patterns": ["bypass.*signature"],
  "controls": {
    "oracle": {
      "output": {"decision": "reject", "reason": "invalid evidence", "audit_id": "oracle-1"},
      "tool_calls": [
        {"name": "verify_signature", "status": "success"},
        {"name": "write_audit_log", "status": "success"}
      ],
      "trace": [
        {"event": "plan_created"},
        {"event": "verification_completed"}
      ]
    },
    "negative": {"output": {"decision": "accept"}, "tool_calls": [], "trace": []}
  },
  "gate": {"min_score": 0.80, "min_pass_rate": 1.0, "max_overlap": 0.82, "min_trials": 1}
}
